# Copy this file to .env and fill in real values before running the app.

# PostgreSQL connection string. For local dev, point this at a local
# Postgres instance. For hosting on Vercel, use the connection string
# from a free Neon (neon.tech) project (see README "Free hosted demo").
DATABASE_URL="postgresql://user:password@localhost:5432/mechanics_os"

# Secret used to sign session JWTs. Generate a real random value, e.g.:
#   openssl rand -base64 48
# Never commit the real secret.
JWT_SECRET="replace-with-a-long-random-secret-value"

# Password all seeded accounts get on first run (see prisma/seed.js).
# Every account is forced to change it on first login is NOT enforced yet —
# change passwords manually after seeding via the "Account" menu in the app.
SEED_DEFAULT_PASSWORD="ChangeMe123!"
