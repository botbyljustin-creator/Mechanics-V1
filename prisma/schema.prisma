generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEADERSHIP
  DEPT_HEAD
}

enum MetricSection {
  INCLUDE
  OUTPUT
}

model Department {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  short     String
  icon      String
  purpose   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  kpis        Kpi[]
  sops        Sop[]
  metricItems MetricItem[]
}

// One row per "Includes" / "Outputs" bullet — each bullet is its own
// trackable, editable metric (not just static label text).
model MetricItem {
  id           String        @id @default(cuid())
  key          String
  section      MetricSection
  label        String
  unit         String        @default("%")
  higherBetter Boolean       @default(true)
  target       Float         @default(100)
  actual       Float         @default(0)
  order        Int           @default(0)
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  history MetricItemHistory[]

  @@unique([departmentId, section, key])
}

model MetricItemHistory {
  id           String     @id @default(cuid())
  metricItemId String
  metricItem   MetricItem @relation(fields: [metricItemId], references: [id], onDelete: Cascade)
  target       Float
  actual       Float
  changedBy    String? // email of the user who made the change
  changedAt    DateTime   @default(now())

  @@index([metricItemId])
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Kpi {
  id           String   @id @default(cuid())
  key          String
  name         String
  unit         String
  higherBetter Boolean  @default(true)
  target       Float
  actual       Float
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  history KpiHistory[]

  @@unique([departmentId, key])
}

model KpiHistory {
  id        String   @id @default(cuid())
  kpiId     String
  kpi       Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  target    Float
  actual    Float
  changedBy String? // email of the user who made the change
  changedAt DateTime @default(now())

  @@index([kpiId])
}

model Sop {
  id           String     @id @default(cuid())
  title        String
  body         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  updatedBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
